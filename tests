def test_real_mcp_schema_and_paginated_tool_call(monkeypatch: pytest.MonkeyPatch) -> None:
    async def resolve(*args: object) -> list[tuple[str, str]]:
        return [(INSTANCE, "secret")]

    monkeypatch.setattr(jira, "get_all_connectors_for_type", resolve)

    async def scenario() -> None:
        async with httpx.AsyncClient(
            transport=httpx.MockTransport(
                lambda _req: httpx.Response(
                    200,
                    json={
                        "startAt": 0,
                        "maxResults": 50,
                        "total": 1,
                        "issues": [issue()],
                    },
                )
            )
        ) as http_client:

            @asynccontextmanager
            async def lifespan(server: FastMCP) -> AsyncIterator[dict[str, Any]]:
                yield {"http_clients": SimpleNamespace(get_async_client=lambda: http_client)}

            server = FastMCP("Jira protocol test", lifespan=lifespan)
            jira.register_jira_tools(server)
            async with Client(server) as client:
                tools = await client.list_tools()
                assert len(tools) == 9
                assert all(
                    tool.annotations is not None and tool.annotations.readOnlyHint for tool in tools
                )
                result = await client.call_tool(
                    "jira_search_issues_page", {"search_input": {"project": "dep"}}
                )
                assert not result.is_error
                assert "DEP-1" in str(result)

    asyncio.run(scenario())
