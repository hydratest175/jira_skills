@pytest.mark.parametrize("failure", ["timeout", "bad_json", "bad_payload"])
def test_transport_and_payload_errors_are_upstream_failures(
    monkeypatch: pytest.MonkeyPatch, failure: str
) -> None:
    def handler(req: httpx.Request) -> httpx.Response:
        if failure == "timeout":
            raise httpx.ReadTimeout("timed out", request=req)
        if failure == "bad_json":
            return httpx.Response(200, text="not JSON")
        return httpx.Response(200, json={})

    with pytest.raises(JiraToolError):
        asyncio.run(invoke(monkeypatch, "jira_get_issue", handler, issue_key="DEP-1"))


