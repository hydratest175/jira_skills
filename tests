def test_enriched_search_and_per_instance_paging(monkeypatch: pytest.MonkeyPatch) -> None:
    seen = []

    def handler(req: httpx.Request) -> httpx.Response:
        assert req.method == "POST"
        assert req.url.path.endswith("/rest/api/2/search")
        body = json.loads(req.content)
        assert body["startAt"] == 2
        assert body["maxResults"] == 50
        assert "status" in body["fields"] and "project" in body["fields"]
        seen.append(req.url.host)
        return httpx.Response(
            200,
            json={
                "startAt": 2,
                "maxResults": 1,
                "total": 5,
                "issues": [issue(status={"name": "In progress"}, assignee=None)],
            },
        )

    pages = asyncio.run(
        invoke(
            monkeypatch,
            "jira_search_issues_page",
            handler,
            connectors=[(INSTANCE, "one"), (SECOND, "two")],
            search_input=JiraIssueSearchInput(project="DEP", start_at=2),
        )
    )
    assert len(seen) == len(pages) == 2
    assert [p.instance_url for p in pages] == [INSTANCE, SECOND]
    assert all(p.next_start_at == 3 and p.total == 5 for p in pages)
    assert pages[0].issues[0].status == "In progress"
    assert pages[0].issues[0].assignee == ""


