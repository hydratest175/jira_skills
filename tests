INSTANCE = "https://jira.example.test/context"
SECOND = "https://other.example.test"


def issue(key: str = "DEP-1", **fields: Any) -> dict[str, Any]:
    return {"key": key, "fields": {"summary": "Test ticket", **fields}}


async def invoke(
    monkeypatch: pytest.MonkeyPatch,
    name: str,
    handler: Callable[[httpx.Request], httpx.Response],
    *,
    connectors: list[tuple[str, str]] | None = None,
    resolution_error: ConnectorResolutionError | None = None,
    **kwargs: Any,
) -> Any:
    async def resolve(connector_type: str, client: httpx.AsyncClient) -> list[tuple[str, str]]:
        assert connector_type == "jira"
        if resolution_error is not None:
            raise resolution_error
        return connectors if connectors is not None else [(INSTANCE, "secret-token")]

    monkeypatch.setattr(jira, "get_all_connectors_for_type", resolve)
    async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as client:
        ctx = SimpleNamespace(
            lifespan_context={
                "http_clients": SimpleNamespace(get_async_client=lambda: client),
            }
        )
        mcp = FastMCP("Jira test")
        jira.register_jira_tools(mcp)
        tool = await mcp.get_tool(name)
        assert isinstance(tool, FunctionTool)
        return await tool.fn(ctx=ctx, **kwargs)


