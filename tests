def test_complete_issue_fields_and_relationship_direction(monkeypatch: pytest.MonkeyPatch) -> None:
    def handler(req: httpx.Request) -> httpx.Response:
        requested = req.url.params["fields"].split(",")
        assert {"project", "subtasks", "issuelinks", "parent"} <= set(requested)
        return httpx.Response(
            200,
            json=issue(
                project={"key": "DEP"},
                parent=issue("DEP-2"),
                subtasks=[issue("DEP-3")],
                issuelinks=[
                    {
                        "type": {"name": "Blocks", "outward": "blocks"},
                        "outwardIssue": issue("DEP-4"),
                    },
                    {
                        "type": {"name": "Blocks", "inward": "is blocked by"},
                        "inwardIssue": issue("DEP-5"),
                    },
                ],
                comment={"startAt": 0, "total": 4, "comments": [{"id": "1", "body": "First"}]},
            ),
        )

    result = asyncio.run(invoke(monkeypatch, "jira_get_issue", handler, issue_key="dep-1"))[0]
    assert result.project == "DEP"
    assert result.parent.key == "DEP-2"
    assert result.subtasks[0].key == "DEP-3"
    assert [(link.direction, link.relationship) for link in result.links] == [
        ("outward", "blocks"),
        ("inward", "is blocked by"),
    ]
    assert result.comments_total == 4 and result.comments_complete is False
    assert result.comments[0].body == "First"


