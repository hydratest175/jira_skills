def test_normalization_and_raw_jql_preserve_meaning() -> None:
    assert JiraIssueKeyInput(issue_key=" dep-12 ").issue_key == "DEP-12"
    raw = 'summary ~ "two  spaces"\nORDER BY updated DESC'
    search = JiraIssueSearchInput(jql="  " + raw + "  ")
    assert jira._build_jira_search_jql(search) == raw
    with pytest.raises(ValidationError):
        JiraIssueSearchInput(project="DEP OR project=OTHER")


def test_jql_quoting_currentuser_and_labels() -> None:
    query = jira._build_jira_search_jql(
        JiraIssueSearchInput(
            project="dep",
            assignee="currentuser",
            status='A "quoted" status',
            labels="one,two",
        )
    )
    assert 'project = "DEP"' in query
    assert "assignee = currentUser()" in query
    assert r'status = "A \"quoted\" status"' in query
    assert 'labels in ("one", "two")' in query
    assert query.endswith("ORDER BY updated DESC, key ASC")


