"""Jira REST v2 read helpers and normalized response mappers."""

from __future__ import annotations

import logging
from typing import Any, Literal

import httpx

from app.jira_models import (
    JiraComment,
    JiraDetailLevel,
    JiraIssue,
    JiraIssueLink,
    JiraIssueSummary,
    JiraProject,
    JiraSearchIssue,
)

logger = logging.getLogger(__name__)
_JIRA_API = "/rest/api/2"


async def jira_get(
    client: httpx.AsyncClient,
    instance_url: str,
    token: str,
    path: str,
    params: dict[str, Any] | None = None,
    *,
    api: Literal["core", "agile"] = "core",
) -> Any:
    """GET from the configured Jira instance. Shared client owns timeouts/TLS."""
    base = _JIRA_API if api == "core" else "/rest/agile/1.0"
    url = f"{instance_url.rstrip('/')}{base}{path}"
    logger.debug("Jira GET request")
    response = await client.get(
        url,
        headers={"Authorization": f"Bearer {token}"},
        params=params or {},
    )
    response.raise_for_status()
    return response.json()


async def jira_post(
    client: httpx.AsyncClient,
    instance_url: str,
    token: str,
    path: str,
    body: dict[str, Any],
) -> Any:
    """POST a read-only search. Mutation routes are deliberately rejected."""
    if path != "/search":
        raise ValueError("Read-only Jira client only allows POST /search")
    url = f"{instance_url.rstrip('/')}{_JIRA_API}{path}"
    logger.debug("Jira search request")
    response = await client.post(
        url,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
        json=body,
    )
    response.raise_for_status()
    return response.json()


def _text(value: Any) -> str:
    """The configured REST v2 contract expects text, not rich-document objects."""
    if value is None:
        return ""
    if not isinstance(value, str):
        raise ValueError("Unexpected Jira text format; verify the instance API version")
    return value


def parse_project(instance_url: str, raw: dict[str, Any]) -> JiraProject:
    return JiraProject(
        instance_url=instance_url,
        key=raw["key"],
        name=raw["name"],
        url=f"{instance_url.rstrip('/')}/projects/{raw['key']}",
    )


def parse_comment(raw: dict[str, Any]) -> JiraComment:
    return JiraComment(
        id=str(raw.get("id") or ""),
        author=(raw.get("author") or {}).get("displayName", ""),
        body=_text(raw.get("body")),
        created=raw.get("created") or "",
        updated=raw.get("updated") or "",
    )


def parse_issue_summary(instance_url: str, raw: dict[str, Any]) -> JiraIssueSummary:
    fields = raw.get("fields") or {}
    key = raw["key"]
    return JiraIssueSummary(
        instance_url=instance_url,
        key=key,
        summary=fields.get("summary") or "",
        url=f"{instance_url.rstrip('/')}/browse/{key}",
        project=(fields.get("project") or {}).get("key", ""),
        status=(fields.get("status") or {}).get("name", ""),
        priority=(fields.get("priority") or {}).get("name", ""),
        assignee=(fields.get("assignee") or {}).get("displayName", ""),
        type=(fields.get("issuetype") or {}).get("name", ""),
        updated=fields.get("updated") or "",
        labels=fields.get("labels") or [],
        components=[c["name"] for c in fields.get("components") or []],
    )


def parse_issue(instance_url: str, raw: dict[str, Any]) -> JiraIssue:
    fields = raw.get("fields") or {}
    comment_data = fields.get("comment") or {}
    comments = [parse_comment(c) for c in comment_data.get("comments", [])]
    total = comment_data.get("total")
    comments_complete = None
    if total is not None:
        comments_complete = comment_data.get("startAt", 0) == 0 and len(comments) >= total
    links: list[JiraIssueLink] = []
    directions: tuple[Literal["inward", "outward"], ...] = ("inward", "outward")
    for link in fields.get("issuelinks") or []:
        link_type = link.get("type") or {}
        for direction in directions:
            linked_issue = link.get(f"{direction}Issue")
            if linked_issue:
                links.append(
                    JiraIssueLink(
                        type=link_type.get("name", ""),
                        direction=direction,
                        relationship=link_type.get(direction, ""),
                        issue=parse_issue_summary(instance_url, linked_issue),
                    )
                )
    summary = parse_issue_summary(instance_url, raw)
    return JiraIssue(
        **summary.model_dump(),
        description=_text(fields.get("description")),
        reporter=(fields.get("reporter") or {}).get("displayName", ""),
        created=fields.get("created") or "",
        comments=comments,
        comments_total=total,
        comments_complete=comments_complete,
        due_date=fields.get("duedate") or "",
        resolution=(fields.get("resolution") or {}).get("name", ""),
        fix_versions=[v["name"] for v in fields.get("fixVersions") or []],
        parent=parse_issue_summary(instance_url, fields["parent"])
        if fields.get("parent")
        else None,
        subtasks=[parse_issue_summary(instance_url, s) for s in fields.get("subtasks") or []],
        links=links,
    )


def parse_page_metadata(
    instance_url: str,
    raw: dict[str, Any],
    count: int,
    requested_start: int,
    requested_limit: int,
) -> dict[str, Any]:
    """Advance by actual returned items, including when Jira caps page size."""
    start = int(raw.get("startAt", requested_start))
    if start != requested_start:
        raise ValueError("Jira returned a different page offset than requested")
    total = raw.get("total")
    if total is not None:
        total = int(total)
        if total < 0:
            raise ValueError("Jira returned a negative total")
    next_start = start + count if count else None
    if total is not None and next_start is not None and next_start >= total:
        next_start = None
    is_last = raw.get("isLast")
    if is_last is not None and not isinstance(is_last, bool):
        raise ValueError("Invalid isLast metadata")
    if (
        (not count and (is_last is False or (total is not None and start < total)))
        or (is_last is False and total is not None and start + count >= total)
        or (is_last is True and total is not None and start + count < total)
    ):
        raise ValueError("Inconsistent Jira pagination metadata")
    if is_last is True:
        next_start = None
    return {
        "instance_url": instance_url,
        "start_at": start,
        "max_results": int(raw.get("maxResults", requested_limit)),
        "returned_count": count,
        "total": total,
        "next_start_at": next_start,
        "complete": start == 0 and next_start is None,
    }


def parse_search_issue(
    instance_url: str,
    raw: dict[str, Any],
    detail_level: JiraDetailLevel,
    description_limit: int,
) -> JiraSearchIssue:
    summary = parse_issue_summary(instance_url, raw)
    result = JiraSearchIssue(**summary.model_dump())
    if detail_level == "full":
        fields = raw.get("fields") or {}
        description = _text(fields.get("description"))
        result.description = description[:description_limit]
        result.description_length = len(description)
        result.description_truncated = len(description) > description_limit
        result.reporter = (fields.get("reporter") or {}).get("displayName", "")
        result.created = fields.get("created") or ""
        result.due_date = fields.get("duedate") or ""
        result.resolution = (fields.get("resolution") or {}).get("name", "")
        result.fix_versions = [v["name"] for v in fields.get("fixVersions") or []]
    return result
