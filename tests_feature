def test_mcp_error_survives_masking(monkeypatch: pytest.MonkeyPatch) -> None:
    async def resolve(*args: object) -> list[tuple[str, str]]:
        return [(INSTANCE, "secret")]

    monkeypatch.setattr(jira, "get_all_connectors_for_type", resolve)

    async def scenario() -> None:
        async with httpx.AsyncClient(
            transport=httpx.MockTransport(lambda _req: httpx.Response(401, text="private-body"))
        ) as http_client:

            @asynccontextmanager
            async def lifespan(server: FastMCP) -> AsyncIterator[dict[str, Any]]:
                yield {"http_clients": SimpleNamespace(get_async_client=lambda: http_client)}

            server = FastMCP("masked", lifespan=lifespan, mask_error_details=True)
            jira.register_jira_tools(server)
            async with Client(server) as client:
                result = await client.call_tool(
                    "jira_get_issue", {"issue_key": "DEP-1"}, raise_on_error=False
                )
                assert result.is_error
                assert "AUTHENTICATION_FAILED" in str(result)
                assert "private-body" not in str(result)
                assert "secret" not in str(result)

    asyncio.run(scenario())
