def test_search_partial_failure_and_legacy_fail(monkeypatch: pytest.MonkeyPatch) -> None:
    def handler(req: httpx.Request) -> httpx.Response:
        if req.url.host == "other.example.test":
            return httpx.Response(429, headers={"Retry-After": "12"}, text="secret-upstream-body")
        return httpx.Response(200, json={"issues": [issue()], "total": 1})

    connectors = [(INSTANCE, "one"), (SECOND, "two")]
    pages = asyncio.run(
        invoke(
            monkeypatch,
            "jira_search_issues_page",
            handler,
            connectors=connectors,
            search_input=JiraIssueSearchInput(),
        )
    )
    assert pages[0].complete and pages[0].issues[0].key == "DEP-1"
    assert pages[1].status == "error" and not pages[1].complete
    assert pages[1].total is None and pages[1].next_start_at is None
    assert pages[1].error.code == "RATE_LIMITED"
    assert pages[1].error.retry_after_seconds == 12
    assert "secret-upstream-body" not in pages[1].model_dump_json()
    with pytest.raises(JiraToolError) as caught:
        asyncio.run(invoke(monkeypatch, "jira_search_issues", handler, connectors=connectors))
    assert caught.value.error.code == "RATE_LIMITED"


@pytest.mark.parametrize(
    "status,code,retryable",
    [
        (400, "INVALID_REQUEST", False),
        (401, "AUTHENTICATION_FAILED", False),
        (403, "FORBIDDEN", False),
        (404, "NOT_FOUND_OR_INACCESSIBLE", False),
        (429, "RATE_LIMITED", True),
        (503, "UPSTREAM_UNAVAILABLE", True),
    ],
)
def test_error_contract(
    monkeypatch: pytest.MonkeyPatch, status: int, code: str, retryable: bool
) -> None:
    pages = asyncio.run(
        invoke(
            monkeypatch,
            "jira_search_issues_page",
            lambda _req: httpx.Response(status, text="not-for-agent"),
            search_input=JiraIssueSearchInput(),
        )
    )
    error = pages[0].error
    assert error.code == code and error.http_status == status and error.retryable == retryable
    assert "not-for-agent" not in error.model_dump_json()


def test_retry_after_date_and_invalid_header() -> None:
    request = httpx.Request("GET", INSTANCE)
    for header, expected in [
        ("not-a-date", None),
        ("-1", 0),
        (format_datetime(datetime.now(UTC) + timedelta(seconds=60)), 60),
    ]:
        response = httpx.Response(503, headers={"Retry-After": header}, request=request)
        exc = httpx.HTTPStatusError("unused", request=request, response=response)
        value = upstream_error(exc, "test", INSTANCE).retry_after_seconds
        if expected == 60:
            assert value is not None and 58 <= value <= 60
        else:
            assert value == expected


