def test_batch_dedup_moved_key_and_partial_failure(monkeypatch: pytest.MonkeyPatch) -> None:
    seen: list[str] = []

    def handler(req: httpx.Request) -> httpx.Response:
        seen.append(req.url.path)
        assert "comment" not in req.url.params["fields"].split(",")
        if req.url.path.endswith("DEP-2"):
            return httpx.Response(404)
        return httpx.Response(200, json=issue("NEW-1", description="x" * 250))

    result = asyncio.run(
        invoke(
            monkeypatch,
            "jira_get_issues_batch",
            handler,
            batch_input=JiraBatchInput(
                issue_keys=["dep-1", "DEP-2", "DEP-1"], description_limit=200
            ),
        )
    )
    assert len(seen) == 2 and result.success_count == result.failure_count == 1
    assert result.items[0].requested_key == "DEP-1" and result.items[0].issue.key == "NEW-1"
    assert result.items[1].error.code == "NOT_FOUND_OR_INACCESSIBLE"
    assert len(result.items[0].issue.description) == 200
    assert not result.items[0].issue.comments_included
    assert result.content_truncated and not result.complete


def test_batch_concurrency_bound(monkeypatch: pytest.MonkeyPatch) -> None:
    async def scenario() -> None:
        active = peak = 0
        entered_four = asyncio.Event()

        async def resolve(*args: object) -> list[tuple[str, str]]:
            return [(INSTANCE, "secret")]

        async def handler(req: httpx.Request) -> httpx.Response:
            nonlocal active, peak
            active += 1
            peak = max(peak, active)
            if active == 4:
                entered_four.set()
            await asyncio.wait_for(entered_four.wait(), timeout=2)
            await asyncio.sleep(0)
            active -= 1
            return httpx.Response(200, json=issue(req.url.path.rsplit("/", 1)[1]))

        monkeypatch.setattr(jira, "get_all_connectors_for_type", resolve)
        async with httpx.AsyncClient(transport=httpx.MockTransport(handler)) as http_client:

            @asynccontextmanager
            async def lifespan(server: FastMCP) -> AsyncIterator[dict[str, Any]]:
                yield {"http_clients": SimpleNamespace(get_async_client=lambda: http_client)}

            server = FastMCP("batch", lifespan=lifespan)
            jira.register_jira_tools(server)
            async with Client(server) as client:
                result = await client.call_tool(
                    "jira_get_issues_batch",
                    {"batch_input": {"issue_keys": [f"DEP-{i}" for i in range(1, 13)]}},
                )
                assert not result.is_error
                assert result.structured_content is not None
                assert result.structured_content["success_count"] == 12
            assert peak == 4

    asyncio.run(scenario())


