def test_search_detail_levels_and_components(monkeypatch: pytest.MonkeyPatch) -> None:
    for level in ("compact", "standard", "full"):

        def handler(req: httpx.Request, level: str = level) -> httpx.Response:
            body = json.loads(req.content)
            assert "comment" not in body["fields"]
            assert ("description" in body["fields"]) == (level == "full")
            assert ("components" in body["fields"]) == (level != "compact")
            fields: dict[str, Any] = {}
            if level != "compact":
                fields["components"] = [{"name": "Data"}]
            if level == "full":
                fields["description"] = "x" * 250
            return httpx.Response(200, json={"total": 1, "issues": [issue(**fields)]})

        pages = asyncio.run(
            invoke(
                monkeypatch,
                "jira_search_issues_page",
                handler,
                search_input=JiraIssueSearchInput.model_validate(
                    {
                        "detail_level": level,
                        "max_results": 20,
                        "description_limit": 200,
                    }
                ),
            )
        )
        page = pages[0]
        assert page.status == "ok"
        assert page.content_truncated == (level == "full")
        assert page.complete == (level != "full")
        if level == "full":
            assert len(page.issues[0].description) == 200
            assert page.issues[0].description_length == 250
        if level != "compact":
            assert page.issues[0].components == ["Data"]


